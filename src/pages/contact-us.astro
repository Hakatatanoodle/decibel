---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SITE_NAME } from '../config/site.js';
---

<BaseLayout
  title="Contact Us"
  description={`Contact the ${SITE_NAME} team — questions, bug reports, partnership ideas or feedback about the online decibel meter. We read every message.`}
>
  <section class="mx-auto w-full max-w-6xl px-4 sm:px-6 pt-10 sm:pt-14 pb-6">
    <p class="text-xs font-mono uppercase tracking-[0.2em] text-accent-hover dark:text-accent-light">Get in touch</p>
    <h1
      class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-ink dark:text-dark-ink"
    >
      Contact Us
    </h1>
    <p class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-body dark:text-dark-body">
      Whether something broke, you have an idea for a feature, or you want to
      partner with us — send a note. Messages usually get a reply within two
      working days.
    </p>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 sm:px-6 pb-16">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,320px)]">
      <div class="rounded-2xl border rule bg-surface dark:bg-dark-surface p-5 sm:p-6">
        <h2 class="text-lg font-semibold text-ink dark:text-dark-ink">Email us</h2>
        <p class="mt-2 text-sm leading-relaxed text-body dark:text-dark-body">
          The fastest way to reach us is plain email. Include the browser and
          device you were using if you are reporting a bug — it helps us
          reproduce the issue immediately.
        </p>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="mt-4 inline-flex items-center justify-center h-10 px-5 rounded-full bg-accent hover:bg-accent-hover text-on-accent text-sm font-medium transition-colors"
        >
          {CONTACT_EMAIL}
        </a>

        <h2 class="mt-8 text-lg font-semibold text-ink dark:text-dark-ink">What to write about</h2>
        <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-body dark:text-dark-body list-disc pl-5">
          <li>Bug reports — what happened, what you expected, which browser.</li>
          <li>Feature requests — who it would help and how you work today.</li>
          <li>Schools and volume use — classroom deployments and custom setups.</li>
          <li>Press and partnerships — we are happy to talk.</li>
        </ul>
      </div>

      <aside class="space-y-4">
        <div class="rounded-2xl border rule bg-surface dark:bg-dark-surface p-5">
          <h2 class="text-sm font-semibold text-ink dark:text-dark-ink">Quick links</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a class="text-accent-hover hover:text-accent-strong dark:text-accent-light underline underline-offset-2" href="/">Try the meter</a>
            </li>
            <li>
              <a class="text-accent-hover hover:text-accent-strong dark:text-accent-light underline underline-offset-2" href="/about-us/">About us</a>
            </li>
            <li>
              <a class="text-accent-hover hover:text-accent-strong dark:text-accent-light underline underline-offset-2" href="/privacy-policy/">Privacy policy</a>
            </li>
            <li>
              <a class="text-accent-hover hover:text-accent-strong dark:text-accent-light underline underline-offset-2" href="/terms-and-conditions/">Terms &amp; conditions</a>
            </li>
          </ul>
        </div>
        <div class="rounded-2xl border rule bg-surface dark:bg-dark-surface p-5">
          <h2 class="text-sm font-semibold text-ink dark:text-dark-ink">Before you write</h2>
          <p class="mt-2 text-sm leading-relaxed text-body dark:text-dark-body">
            Microphone not working? It is usually browser permission or an
            insecure (non-HTTPS) connection. Check the address bar’s camera
            icon, allow the microphone, and reload — that fixes it most of the
            time.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
