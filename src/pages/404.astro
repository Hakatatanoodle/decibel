---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist. Head back to the online decibel meter."
  noindex
>
  <section
    class="mx-auto w-full max-w-6xl px-4 sm:px-6 py-20 sm:py-28 flex flex-col items-center text-center"
  >
    <p class="text-xs font-mono uppercase tracking-[0.2em] text-accent">Error 404</p>
    <h1
      class="mt-3 text-4xl sm:text-6xl font-semibold tracking-tight text-ink dark:text-dark-ink"
    >
      Page not found
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-body dark:text-dark-body">
      That URL does not exist — perhaps it moved, or the link was mistyped.
      The meter is one click away.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center h-10 px-6 rounded-full bg-accent hover:bg-accent-hover text-on-accent text-sm font-medium transition-colors"
    >
      Back to the decibel meter
    </a>
  </section>
</BaseLayout>
