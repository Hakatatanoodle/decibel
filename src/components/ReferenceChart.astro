---
/**
 * Noise reference chart — shows common environments with dB ranges.
 * The live meter script highlights the row matching the current reading
 * (rows carry data-min/data-max attributes).
 */
const ROWS = [
  { label: 'Whisper', range: '20–35 dB', min: 20, max: 35 },
  { label: 'Library', range: '30–45 dB', min: 30, max: 45 },
  { label: 'Classroom', range: '40–65 dB', min: 40, max: 65 },
  { label: 'Conversation', range: '50–70 dB', min: 50, max: 70 },
  { label: 'City traffic', range: '65–90 dB', min: 65, max: 90 },
  { label: 'Concert', range: '95–120 dB', min: 95, max: 120 },
];
---

<div class="rounded-2xl border rule bg-surface dark:bg-dark-surface overflow-hidden">
  <div class="px-4 sm:px-5 py-3 border-b rule flex items-baseline justify-between gap-3">
    <h3 class="text-sm font-semibold text-ink dark:text-dark-ink">Noise reference chart</h3>
    <span class="text-xs text-faint font-mono">highlighted = current level</span>
  </div>
  <ul class="divide-y divide-hairline dark:divide-dark-hairline">
    {
      ROWS.map((row) => (
        <li
          data-ref-row
          data-min={row.min}
          data-max={row.max}
          class="flex items-center justify-between gap-4 px-4 sm:px-5 py-2.5 transition-colors"
        >
          <span class="text-sm text-body dark:text-dark-body" data-ref-label>
            {row.label}
          </span>
          <span
            class="text-xs font-mono text-mute dark:text-dark-mute tabular-nums"
            data-ref-range
          >
            {row.range}
          </span>
        </li>
      ))
    }
  </ul>
</div>
